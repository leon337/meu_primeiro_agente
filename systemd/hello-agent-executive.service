[Unit]
Description=Hello Agent - runtime executivo local
After=network-online.target hello-agent-bridge.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documentos/GitHub/meu_primeiro_agente
ExecStart=%h/Documentos/GitHub/meu_primeiro_agente/.venv/bin/python -m app.runtime.daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/Documentos/GitHub/meu_primeiro_agente/var %h/Documentos/GitHub/meu_primeiro_agente/.runtime

[Install]
WantedBy=default.target
